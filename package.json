{
  "name": "mantijudicial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pipeline de analisis de jurisprudencia y legislacion para la plataforma juridica MantiJudicial",
  "scripts": {
    "hygiene": "tsx pipeline/01_hygiene.ts",
    "extract": "tsx pipeline/02_extract.ts",
    "metadata": "tsx pipeline/03_metadata.ts",
    "enrich": "tsx pipeline/04_enrich.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "laws": "tsx pipeline/05_laws.ts",
    "match": "tsx pipeline/06_match.ts",
    "patterns": "tsx pipeline/07_patterns.ts",
    "search": "tsx pipeline/08_search.ts",
    "web": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:start": "pnpm --dir apps/web start",
    "audit:failed": "tsx pipeline/audit_failed.ts",
    "ingest": "tsx pipeline/09_ingest.ts",
    "vias": "tsx pipeline/10_vias.ts",
    "seed": "tsx pipeline/11_seed.ts",
    "eval": "tsx pipeline/12_eval.ts",
    "supplement": "tsx pipeline/13_supplement.ts",
    "eval:show": "tsx pipeline/12_eval.ts --show",
    "compare": "tsx pipeline/14_compare.ts",
    "escrito": "tsx pipeline/15_escrito.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
